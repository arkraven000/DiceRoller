<Project>
  <!-- Security and Quality Settings Applied to All Projects -->
  <PropertyGroup>
    <!-- Security: Enable all analyzers -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>

    <!-- Security: Treat warnings as errors -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Security: Enforce code style in build -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Language: Enable latest features -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Deterministic builds for supply chain security -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Assembly information -->
    <Authors>DiceRoller Team</Authors>
    <Company>DiceRoller</Company>
    <Product>Warhammer 40K Dice Calculator</Product>
    <Copyright>Copyright © 2025</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/your-org/DiceRoller</RepositoryUrl>
  </PropertyGroup>

  <!-- Security: NuGet audit settings -->
  <PropertyGroup>
    <!-- Enable NuGet vulnerability scanning -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <!-- Fail build on any security vulnerabilities -->
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <!-- Security: Source Link for debugging and transparency -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All"/>
  </ItemGroup>

  <!-- Security: Override vulnerable transitive dependencies -->
  <ItemGroup>
    <!-- Fix GHSA-7jgj-8wvc-jh57: System.Net.Http vulnerability -->
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <!-- Fix GHSA-5f2m-466j-3848, GHSA-xhfc-gr8f-ffwc, GHSA-x5qj-9vmx-7g6g: System.Private.Uri vulnerabilities -->
    <PackageReference Include="System.Private.Uri" Version="4.3.2" />
    <!-- Fix GHSA-cmhx-cq75-c4mj: System.Text.RegularExpressions vulnerability -->
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
  </ItemGroup>
</Project>
