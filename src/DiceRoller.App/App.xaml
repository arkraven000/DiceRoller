<Application
    x:Class="DiceRoller.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- WARHAMMER 40K GRIMDARK COLOR PALETTE -->
            <!-- "In the grim darkness of the far future, there is only war" -->

            <!-- Background Colors - Deep Blacks and Grays -->
            <Color x:Key="VoidBlack">#0A0A0A</Color>
            <Color x:Key="HiveGray">#1A1A1A</Color>
            <Color x:Key="AdamantiumGray">#2A2A2A</Color>
            <Color x:Key="CeramiteGray">#3A3A3A</Color>

            <!-- Accent Colors - Blood and Fire -->
            <Color x:Key="BloodRed">#8B0000</Color>
            <Color x:Key="ImperialCrimson">#B22222</Color>
            <Color x:Key="WarhammerGold">#FFD700</Color>
            <Color x:Key="PlasmaBlue">#1E90FF</Color>

            <!-- Text Colors -->
            <Color x:Key="AquilaWhite">#E8E8E8</Color>
            <Color x:Key="BoneWhite">#D4D4D4</Color>
            <Color x:Key="SkullGray">#A0A0A0</Color>

            <!-- Status Colors -->
            <Color x:Key="XenosGreen">#228B22</Color>
            <Color x:Key="ChaosPurple">#8B008B</Color>
            <Color x:Key="WarningOrange">#FF8C00</Color>

            <!-- Brushes -->
            <SolidColorBrush x:Key="VoidBlackBrush" Color="{StaticResource VoidBlack}"/>
            <SolidColorBrush x:Key="HiveGrayBrush" Color="{StaticResource HiveGray}"/>
            <SolidColorBrush x:Key="AdamantiumGrayBrush" Color="{StaticResource AdamantiumGray}"/>
            <SolidColorBrush x:Key="CeramiteGrayBrush" Color="{StaticResource CeramiteGray}"/>

            <SolidColorBrush x:Key="BloodRedBrush" Color="{StaticResource BloodRed}"/>
            <SolidColorBrush x:Key="ImperialCrimsonBrush" Color="{StaticResource ImperialCrimson}"/>
            <SolidColorBrush x:Key="WarhammerGoldBrush" Color="{StaticResource WarhammerGold}"/>
            <SolidColorBrush x:Key="PlasmaB​lueBrush" Color="{StaticResource PlasmaBlue}"/>

            <SolidColorBrush x:Key="AquilaWhiteBrush" Color="{StaticResource AquilaWhite}"/>
            <SolidColorBrush x:Key="BoneWhiteBrush" Color="{StaticResource BoneWhite}"/>
            <SolidColorBrush x:Key="SkullGrayBrush" Color="{StaticResource SkullGray}"/>

            <SolidColorBrush x:Key="XenosGreenBrush" Color="{StaticResource XenosGreen}"/>
            <SolidColorBrush x:Key="ChaosPurpleBrush" Color="{StaticResource ChaosPurple}"/>
            <SolidColorBrush x:Key="WarningOrangeBrush" Color="{StaticResource WarningOrange}"/>

            <!-- Application-wide Styles -->
            <Style TargetType="Page">
                <Setter Property="Background" Value="{StaticResource HiveGrayBrush}"/>
            </Style>

            <!-- Card/Panel Style -->
            <Style x:Key="GrimdarkCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource AdamantiumGrayBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BloodRedBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="8"/>
            </Style>

            <!-- Header Text Style -->
            <Style x:Key="GothicHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource AquilaWhiteBrush}"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <!-- Subheader Style -->
            <Style x:Key="SubheaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource WarhammerGoldBrush}"/>
                <Setter Property="Margin" Value="0,8,0,8"/>
            </Style>

            <!-- Body Text Style -->
            <Style x:Key="BodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{StaticResource BoneWhiteBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- Button Style - Imperial Crimson -->
            <Style x:Key="ImperialButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BloodRedBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource AquilaWhiteBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ImperialCrimsonBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="CornerRadius" Value="4"/>
            </Style>

            <!-- NumberBox Style -->
            <Style x:Key="GrimdarkNumberBoxStyle" TargetType="NumberBox">
                <Setter Property="Background" Value="{StaticResource CeramiteGrayBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource AquilaWhiteBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource SkullGrayBrush}"/>
                <Setter Property="SpinButtonPlacementMode" Value="Inline"/>
            </Style>

            <!-- TextBox Style -->
            <Style x:Key="GrimdarkTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource CeramiteGrayBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource AquilaWhiteBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource SkullGrayBrush}"/>
            </Style>

            <!-- ComboBox Style -->
            <Style x:Key="GrimdarkComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Background" Value="{StaticResource CeramiteGrayBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource AquilaWhiteBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource SkullGrayBrush}"/>
            </Style>

            <!-- Progress Ring Style -->
            <Style x:Key="ImperialProgressStyle" TargetType="ProgressRing">
                <Setter Property="Foreground" Value="{StaticResource BloodRedBrush}"/>
            </Style>

            <!-- Value Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"
                xmlns:converters="using:DiceRoller.App.Converters"/>
            <converters:StringVisibilityConverter x:Key="StringVisibilityConverter"
                xmlns:converters="using:DiceRoller.App.Converters"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"
                xmlns:converters="using:DiceRoller.App.Converters"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
