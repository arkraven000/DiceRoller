<Page
    x:Class="DiceRoller.App.Views.WeaponLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border
            Grid.Row="0"
            Style="{StaticResource GrimdarkCardStyle}"
            BorderBrush="{StaticResource WarhammerGoldBrush}"
            BorderThickness="0,0,0,2"
            Margin="0,0,0,16">
            <StackPanel>
                <TextBlock
                    Text="⚔ WEAPON ARSENAL ⚔"
                    Style="{StaticResource GothicHeaderStyle}"
                    HorizontalAlignment="Center"
                    FontSize="32"
                    Foreground="{StaticResource WarhammerGoldBrush}"/>
                <TextBlock
                    Text="The Emperor's armory - weapons of war catalog"
                    Style="{StaticResource BodyTextStyle}"
                    HorizontalAlignment="Center"
                    Foreground="{StaticResource SkullGrayBrush}"
                    Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Border
            Grid.Row="1"
            Style="{StaticResource GrimdarkCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- SEARCH AND ACTIONS -->
                <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            PlaceholderText="Search weapons by name..."
                            Style="{StaticResource GrimdarkTextBoxStyle}"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                            Margin="0,0,8,0"/>

                        <Button
                            Grid.Column="1"
                            Content="Search"
                            Style="{StaticResource ImperialButtonStyle}"
                            Command="{x:Bind ViewModel.SearchUnitsCommand}"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Content="+ Create New Weapon"
                            Style="{StaticResource ImperialButtonStyle}"
                            Command="{x:Bind ViewModel.CreateNewCommand}"/>

                        <Button
                            Content="Edit Selected"
                            Background="{StaticResource PlasmaB​lueBrush}"
                            Foreground="{StaticResource AquilaWhiteBrush}"
                            Command="{x:Bind ViewModel.EditSelectedCommand}"/>

                        <Button
                            Content="Delete Selected"
                            Background="{StaticResource BloodRedBrush}"
                            Foreground="{StaticResource AquilaWhiteBrush}"
                            Command="{x:Bind ViewModel.DeleteSelectedCommand}"/>

                        <Button
                            Content="Refresh"
                            Background="{StaticResource CeramiteGrayBrush}"
                            Foreground="{StaticResource AquilaWhiteBrush}"
                            Command="{x:Bind ViewModel.LoadWeaponsCommand}"/>
                    </StackPanel>
                </StackPanel>

                <!-- WEAPON LIST -->
                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Weapons, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedWeapon, Mode=TwoWay}"
                    Background="{StaticResource VoidBlackBrush}"
                    BorderBrush="{StaticResource SkullGrayBrush}"
                    BorderThickness="1">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Background="{StaticResource AdamantiumGrayBrush}"
                                BorderBrush="{StaticResource BloodRedBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12"
                                Margin="4">
                                <StackPanel>
                                    <TextBlock
                                        Text="{Binding Name}"
                                        Style="{StaticResource SubheaderStyle}"
                                        FontSize="16"/>
                                    <TextBlock
                                        Style="{StaticResource BodyTextStyle}"
                                        FontSize="12">
                                        <Run Text="A:"/>
                                        <Run Text="{Binding Attacks}"/>
                                        <Run Text=" | BS:"/>
                                        <Run Text="{Binding BallisticSkill}"/>
                                        <Run Text="+ | S:"/>
                                        <Run Text="{Binding Strength}"/>
                                        <Run Text=" | AP:"/>
                                        <Run Text="{Binding ArmorPenetration}"/>
                                        <Run Text=" | D:"/>
                                        <Run Text="{Binding DamageType}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- STATUS MESSAGE -->
                <Border
                    Grid.Row="2"
                    Background="{StaticResource AdamantiumGrayBrush}"
                    BorderBrush="{StaticResource WarhammerGoldBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12"
                    Margin="0,16,0,0"
                    Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}">
                    <TextBlock
                        Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        Style="{StaticResource BodyTextStyle}"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource WarhammerGoldBrush}"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
